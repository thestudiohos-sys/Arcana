APP_ENV=development
PORT=8000
HOST=127.0.0.1

# Reading Provider Mode: "mock" (Local Python Mock) or "gemini" (Google Gemini AI)
READING_PROVIDER=mock

# Gemini API Configuration (Required ONLY when READING_PROVIDER=gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Analytics Provider Mode: "disabled" (safe local default) or "supabase"
ANALYTICS_PROVIDER=disabled

# Required ONLY when ANALYTICS_PROVIDER=supabase. Keep server-side only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
ANALYTICS_SUPABASE_TIMEOUT_SECONDS=2.5

# Minimal in-memory protection for POST /api/analytics/events
ANALYTICS_RATE_LIMIT=120
ANALYTICS_RATE_LIMIT_WINDOW_SECONDS=60
